<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/partials.css"
  />

  <title>Notifications | Nail Salon</title>
</head>

<body>

  <%- include('../partials/_navbar.ejs') %>


  <main class="notifications-page">

    <!-- PAGE HEADER -->

    <section class="notifications-header">

      <p class="section-label">
        STAY UP TO DATE
      </p>

      <h1>
        Your
        <br />
        notifications
      </h1>

      <p class="notifications-intro">
        Keep an eye on your upcoming appointments
        and never miss your little moment of self-care
      </p>

    </section>


    <!-- NOTIFICATIONS -->

    <% if (appointments.length === 0) { %>

      <section class="no-notifications">

        <div class="notification-icon">
          ✓
        </div>

        <h2>
          You're all caught up
        </h2>

        <p>
          You don't have any upcoming appointments
        </p>

        <a
          href="/services"
          class="notifications-button"
        >
          Book an Appointment
        </a>

      </section>

    <% } else { %>

      <section class="notifications-list">

        <% appointments.forEach((appointment, index) => { %>

          <%
            const appointmentDate =
              new Date(appointment.appointmentDate);

            const today = new Date();

            const differenceInTime =
              appointmentDate.getTime() -
              today.getTime();

            const differenceInDays =
              Math.ceil(
                differenceInTime /
                (1000 * 60 * 60 * 24)
              );
          %>


          <article class="notification-card">

            <!-- NUMBER -->

            <div class="notification-number">

              <%= String(index + 1).padStart(2, '0') %>

            </div>


            <!-- CONTENT -->

            <div class="notification-content">

              <p class="notification-label">
                UPCOMING APPOINTMENT
              </p>


              <h2>
                <%= appointment.service.name %>
              </h2>


              <!-- REMINDER -->

              <div class="notification-message">

                <% if (differenceInDays <= 0) { %>

                  <strong>
                    Your appointment is today!
                  </strong>

                <% } else if (differenceInDays === 1) { %>

                  <strong>
                    Your appointment is tomorrow!
                  </strong>

                <% } else { %>

                  <strong>
                    Your appointment is in
                    <%= differenceInDays %>
                    days!
                  </strong>

                <% } %>

              </div>


              <!-- DETAILS -->

              <div class="notification-details">

                <div>

                  <span>
                    DATE
                  </span>

                  <strong>
                    <%= appointmentDate.toLocaleDateString() %>
                  </strong>

                </div>


                <div>

                  <span>
                    TIME
                  </span>

                  <strong>

                    <%= new Date(
                      `1970-01-01T${appointment.appointmentTime}`
                    ).toLocaleTimeString(
                      'en-US',
                      {
                        hour: 'numeric',
                        minute: '2-digit'
                      }
                    ) %>

                  </strong>

                </div>

              </div>


              <!-- LINK -->

              <a
                href="/appointments"
                class="notification-link"
              >
                View My Appointments →
              </a>

            </div>

          </article>

        <% }) %>

      </section>

    <% } %>


    <!-- BOTTOM CTA -->

    <section class="notifications-cta">

      <p>
        NEED TO MAKE A CHANGE?
      </p>

      <a href="/appointments">
        View My Appointments →
      </a>

    </section>

  </main>


  <%- include('../partials/_footer.ejs') %>

</body>

</html>