<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/partials.css"
  />

  <title>Services | Nail Salon</title>

</head>


<body>

  <%- include('../partials/_navbar.ejs') %>


  <main class="services-page">


    <!-- =========================================
         SERVICES HERO
         ========================================= -->

    <section class="services-hero">

      <p class="section-label">
        OUR SERVICES
      </p>

      <h1>
        Nails made
        <br />
        for you
      </h1>

      <p class="services-intro">
        Thoughtful treatments, beautiful finishes,
        and a little time dedicated entirely to you.
      </p>

    </section>


    <!-- =========================================
         ADMIN BUTTON
         ========================================= -->

    <% if (user && user.role === 'admin') { %>

      <div class="admin-service-action">

        <a
          href="/services/new"
          class="service-admin-button"
        >
          Add New Service
        </a>

      </div>

    <% } %>


    <!-- =========================================
         SERVICES GRID
         ========================================= -->

    <% if (services.length === 0) { %>

      <p class="no-services">
        No services available at the moment.
      </p>

    <% } else { %>


      <section class="services-grid">


        <% services.forEach((service, index) => { %>


          <article class="service-card">


            <!-- IMAGE -->

            <div class="service-image">

              <%
                let serviceImage =
                  '/stylesheets/images/hero-nails (2).jpg';

                if (
                  service.name === 'Classic Manicure'
                ) {

                  serviceImage =
                    '/stylesheets/images/ClassicManicure.png';

                } else if (
                  service.name === 'French Manicure'
                ) {

                  serviceImage =
                    '/stylesheets/images/FrenchManicure.png';

                } else if (
                  service.name === 'Gel Manicure'
                ) {

                  serviceImage =
                    '/stylesheets/images/GelManicure.png';

                } else if (
                  service.name === 'Nail Extensions'
                ) {

                  serviceImage =
                    '/stylesheets/images/NailExtensions.png';

                }
              %>


              <img
                src="<%= serviceImage %>"
                alt="<%= service.name %>"
              />

            </div>


            <!-- CONTENT -->

            <div class="service-card-content">


              <!-- NUMBER -->

              <p class="service-number">

                <%= String(index + 1).padStart(2, '0') %>

              </p>


              <!-- SERVICE NAME -->

              <h2>

                <%= service.name %>

              </h2>


              <!-- PRICE + DURATION -->

              <div class="service-info">

                <span>
                  <%= service.price %> BD
                </span>

                <span>
                  <%= service.duration %> min
                </span>

              </div>


              <!-- VIEW DETAILS -->

              <a
                href="/services/<%= service._id %>"
                class="service-details-link"
              >

                <span>
                  View Details
                </span>

                <span>
                  →
                </span>

              </a>


            </div>


          </article>


        <% }) %>


      </section>


    <% } %>


    <!-- =========================================
         BOTTOM CTA
         ========================================= -->

    <section class="services-cta">

      <h2>
        A little time
        <br />
        just for you
      </h2>

     
    </section>


  </main>


  <%- include('../partials/_footer.ejs') %>


</body>

</html>