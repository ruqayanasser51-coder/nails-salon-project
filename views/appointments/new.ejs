<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/partials.css"
  />

  <title>Book Appointment | Nail Salon</title>
</head>

<body>

  <%- include('../partials/_navbar.ejs') %>

<main class="booking-page">

  <div class="booking-layout">

    <div class="booking-image">

      <% let serviceImage = ''; %>

      <% if (service.name === 'Gel Manicure') { %>
        <% serviceImage = '/stylesheets/images/GelManicure.png'; %>

      <% } else if (service.name === 'Classic Manicure') { %>
        <% serviceImage = '/stylesheets/images/ClassicManicure.png'; %>

      <% } else if (service.name === 'French Manicure') { %>
        <% serviceImage = '/stylesheets/images/FrenchManicure.png'; %>

      <% } else if (service.name === 'Nail Extensions') { %>
        <% serviceImage = '/stylesheets/images/NailExtensions.png'; %>
      <% } %>

      <img
        src="<%= serviceImage %>"
        alt="<%= service.name %>"
      />

    </div>


    <div class="booking-content">

      <p class="section-label">
        YOUR APPOINTMENT
      </p>

      <h1>
        Book your
        <br />
        appointment.
      </h1>

      <div class="booking-service">

        <h2>
          <%= service.name %>
        </h2>

        <p>
          Description:
          <%= service.description %>
        </p>

        <div class="booking-service-info">

          <strong>
            <%= service.price %> BD
          </strong>

          <strong>
            <%= service.duration %> minutes
          </strong>

        </div>

      </div>

      <% if (error) { %>

  <div class="booking-error">
    <%= error %>
  </div>

<% } %>
      <form
        action="/appointments"
        method="POST"
        class="booking-form"
      >

        <input
          type="hidden"
          name="serviceId"
          value="<%= service._id %>"
        />

        <div class="form-field">

          <label for="appointmentDate">
            Choose Date
          </label>

          <input
            type="date"
            name="appointmentDate"
            id="appointmentDate"
            required
          />

        </div>


        <div class="form-field">

          <label for="appointmentTime">
            Choose Time
          </label>

          <input
            type="time"
            name="appointmentTime"
            id="appointmentTime"
            required
          />

        </div>


        <div class="form-field">

          <label for="notes">
            Notes
          </label>

          <textarea
            name="notes"
            id="notes"
            placeholder="Any special requests?"
          ></textarea>

        </div>


        <button
          type="submit"
          class="booking-button"
        >
          Confirm Appointment
        </button>

      </form>

      <a
        href="/services"
        class="back-services-link"
      >
        ← Back to Services
      </a>

    </div>

  </div>

</main>


  <%- include('../partials/_footer.ejs') %>

</body>

</html>